# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env (NFR-MNT-03).
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=5000

# Database
# Local:
MONGO_URI=mongodb://127.0.0.1:27017/ispm_savikro
#
# Atlas: take the string from Database > Connect > Drivers > Node.js, then fix
# three things it will not have right:
#   1. Replace the literal <password>.
#   2. Percent-encode the password if it contains @ : / ? # [ ] or %
#      (@ -> %40, # -> %23). An unencoded @ splits the URI in the wrong place.
#   3. Add the database name: .../ispm_savikro?retryWrites=... Atlas omits it,
#      and without it every collection lands in a database called "test".
#
# If mongodb+srv:// fails with "querySrv ECONNREFUSED", your machine's Node DNS
# resolver cannot do SRV lookups. Use the standard non-SRV form instead - it
# resolves through the OS resolver and works regardless:
#   mongodb://USER:PASS@host-00:27017,host-01:27017,host-02:27017/ispm_savikro?ssl=true&replicaSet=RS&authSource=admin
# Get the hosts and replica set from the cluster's own DNS records:
#   nslookup -type=SRV _mongodb._tcp.<cluster>.mongodb.net
#   nslookup -type=TXT <cluster>.mongodb.net
#
# Verify whatever you set with:  npm run check:db

# Auth secrets - generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The two secrets MUST be different: an access token must never validate as a
# refresh token, or a 15-minute credential silently becomes a 7-day one.
JWT_ACCESS_SECRET=replace_me_with_a_long_random_value
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_value

# Token lifetimes
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Account lockout policy (UC-02 5a, US-004)
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MINUTES=15

# Login rate limit, per IP + account, over the same window. Must stay ABOVE
# MAX_LOGIN_ATTEMPTS so the account lockout (423) fires before the flood
# limiter (429) starts absorbing requests.
LOGIN_RATE_LIMIT_MAX=10

# Password hashing (NFR-SEC-02 mandates cost 12)
BCRYPT_COST=12

# CORS allow-list - comma-separated origins permitted to call this API
CLIENT_ORIGINS=http://localhost:5173
