{
  "name": "ispm-backend",
  "version": "1.0.0",
  "description": "Security Policy Awareness & Compliance Management Platform - Backend API",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node seed/seed.js",
    "check:db": "node scripts/check-db.js",
    "test": "cross-env NODE_ENV=test BCRYPT_COST=4 jest --runInBand",
